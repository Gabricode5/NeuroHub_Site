---
// Texte d'implantation + carte OpenStreetMap du site envisagé.
import { site } from '../../data/site';
import { lieuSite as content } from '../../data/content';
---
<div class="grid gap-8 lg:grid-cols-2 lg:items-center">
  <div class="prose">
    {content.paragraphs.map((paragraph, i) => <p class:list={[i === 0 && 'mt-0']}>{paragraph}</p>)}
  </div>
  <iframe class="h-80 w-full border border-blue-soft" title={content.mapTitle} src={site.mapEmbedSrc} loading="lazy"></iframe>
</div>
