---
import Button from '../ui/Button.astro';
import A11yWidget from './A11yWidget.astro';
import { site } from '../../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;
---
<header id="site-header" class="site-header-banner sticky top-0 z-40 border-b border-blue-soft/60 py-6">
  {/* Fond dégradé pleine largeur (retour présidente du 06/10/2026) : le bandeau avec logo
      intégré ne reste lisible qu'en grand (vu précédemment, 391px = trop gros) ou illisible
      en petit (48px = texte imprononçable) — pas de taille qui marche pour les deux à la
      fois sur UNE image. Solution : juste le dégradé en fond (pas de texte dedans), logo +
      nom en vrais éléments HTML par-dessus, toujours nets quelle que soit la taille.
      Contraste vérifié sur toute la largeur du dégradé : l'encre foncée du texte (#313232)
      tient 5.73:1 minimum (AA) ; le bleu profond (état actif) tombe à 2.24:1 sur la zone
      lavande — encre utilisée partout ici (nav + logo), sûre dans tous les cas. Logo sur
      socle blanc plein (.logo-chip) et bouton burger (déjà fond blanc) : contraste garanti
      en interne, indépendant du dégradé derrière. */}
  <div class="site-bar wrap flex items-center justify-between gap-4">
    <a href="/" aria-label="Accueil — Collège de la Neurodiversité" class="shrink-0">
      {/* Logo + nom en une image vraiment transparente (retour présidente du 08/10/2026) :
          pas de socle blanc nécessaire, elle se pose directement sur le dégradé. Recadrée
          depuis le fichier d'origine qui avait ~55% de marge transparente autour du
          contenu réel. Hauteur fixe modeste (leçon du bandeau précédent : pas trop gros). */}
      <img src="/images/header-logo-full.webp" width="1227" height="220" class="header-logo-img" alt="Collège de la Neurodiversité" loading="eager" decoding="async" />
    </a>

    <nav aria-label="Navigation principale" class="site-nav" id="site-nav-panel">
      <ul class="nav-list">
        {site.nav.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
        <li>
          <Button href={site.navCta.href} variant="cta" class="!min-h-0 !px-4 !py-2 text-base">{site.navCta.label}</Button>
        </li>
      </ul>
    </nav>

    {/* Burger (mobile uniquement). */}
    <div class="header-actions">
      <button
        id="nav-toggle"
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav-panel"
      >
        <span class="nav-toggle-box" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  {/* Engrenage d'accessibilité : hors du conteneur centré, tout au bout à droite du bandeau. */}
  <div class="header-a11y">
    <A11yWidget />
  </div>
</header>

<style>
  .site-header-banner {
    background-color: #fff;
    background-image: url('/images/header-banner.webp');
    background-size: cover;
    background-position: center;
  }
  .header-logo-img { display: block; height: 84px; width: auto; }
  .site-nav { margin-left: auto; }
  .header-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .header-a11y {
    position: absolute;
    top: 50%;
    right: clamp(0.5rem, 1.5vw, 1.25rem);
    transform: translateY(-50%);
  }
  /* Tant que le bandeau n'a pas de marge libre à droite du conteneur (1200px), on réserve
     la place de l'engrenage pour qu'il ne chevauche jamais la nav ni le burger. */
  @media (max-width: 1320px) {
    .site-bar { padding-right: calc(clamp(0.5rem, 1.5vw, 1.25rem) + 3rem); }
  }
  @media (max-width: 380px) {
    .header-logo-img { height: 38px !important; }
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 1.1rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.25rem 0;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-ink, #313232);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-link:hover { text-decoration: underline; }
  /* Soulignement seul (pas de changement de couleur) : le bleu profond utilisé ailleurs
     pour l'état actif tombe sous le seuil AA sur une partie du dégradé (voir plus haut). */
  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Bouton burger : masqué au-dessus du point de rupture, la nav reste inline comme avant. */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--color-blue-deep, #2773b2);
    border-radius: var(--radius-sm, 4px);
    background: #fff;
    color: var(--color-blue-deep, #2773b2);
    cursor: pointer;
    flex-shrink: 0;
  }
  /* Icône 3 barres en pur CSS (pas d'image) : la barre du milieu est l'élément lui-même,
     ::before/::after posent les deux autres — se transforme en croix quand le panneau est
     ouvert (transition neutralisée globalement si mouvement réduit, voir global.css). */
  .nav-toggle-box, .nav-toggle-box::before, .nav-toggle-box::after {
    display: block;
    position: absolute;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition: transform .15s ease, opacity .15s ease;
  }
  .nav-toggle-box::before { content: ''; transform: translateY(-6px); }
  .nav-toggle-box::after { content: ''; transform: translateY(6px); }
  .nav-toggle[aria-expanded="true"] .nav-toggle-box { background: transparent; }
  .nav-toggle[aria-expanded="true"] .nav-toggle-box::before { transform: translateY(0) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .nav-toggle-box::after { transform: translateY(0) rotate(-45deg); }

  /* Petits écrans : logo + bouton burger sur une seule ligne (en-tête compact), le menu
     devient un panneau déroulant sous l'en-tête, fermé par défaut (display:none le sort
     aussi du parcours clavier — pas besoin de dupliquer avec [hidden]). */
  @media (max-width: 700px) {
    #site-header { padding-block: 0.65rem; }
    /* Logo le plus grand possible sans chevaucher le burger + l'engrenage (390px testé). */
    .header-logo-img { height: 44px; }
    .site-bar { gap: 0.75rem; }
    .nav-toggle { display: inline-flex; }
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--color-blue-soft, #9bc1dc);
      box-shadow: 0 8px 16px -8px rgba(15, 23, 42, 0.25);
      padding: 0 clamp(1.25rem, 4vw, 2rem) 1.25rem;
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
    }
    .site-nav.is-open { display: block; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0.25rem; padding-top: 0.5rem; }
    .nav-link { padding: 0.65rem 0; font-size: 1.05rem; border-bottom: 1px solid var(--color-blue-soft, #9bc1dc); }
    .nav-list > li:last-child { margin-top: 0.75rem; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const panel = document.querySelector<HTMLElement>('#site-nav-panel');
  const desktopQuery = matchMedia('(min-width: 701px)');

  if (toggle && panel) {
    const focusableSelector = 'a[href], button:not([disabled])';

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const closeMenu = (focusToggle = false) => {
      panel.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      if (focusToggle) toggle.focus();
    };

    const openMenu = () => {
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>(focusableSelector)?.focus();
    };

    toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));

    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu(true);
        return;
      }
      if (e.key !== 'Tab') return;
      const focusables = Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Choisir un lien ferme le panneau (utile en navigation clavier comme au toucher).
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) closeMenu();
    });

    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const target = e.target as Node;
      if (!panel.contains(target) && target !== toggle && !toggle.contains(target)) closeMenu();
    });

    // Repasser au-dessus de 700px (rotation d'écran, redimensionnement) : état propre.
    desktopQuery.addEventListener('change', (e) => { if (e.matches) closeMenu(); });
  }
</script>
