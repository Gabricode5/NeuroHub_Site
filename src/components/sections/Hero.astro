---
import Button from '../ui/Button.astro';
import { hero } from '../../data/content';
---
<section id="accueil" class="hero home-hero">
  {/* Fond : photo de salle de classe (retour du 26/10/2026) sous un voile bleu profond →
      violet. Le titre et l'invitation à défiler sont en blanc sur la partie la plus dense du
      voile ; l'encadré reste une carte blanche opaque (texte encre). */}
  <img
    src="/images/soutenir-bg.webp"
    srcset="/images/soutenir-bg-900.webp 900w, /images/soutenir-bg.webp 1774w"
    sizes="100vw"
    width="1774"
    height="887"
    alt=""
    class="home-hero-bg"
    loading="eager"
    decoding="async"
  />
  <div class="home-hero-veil" aria-hidden="true"></div>

  <div class="wrap grid gap-10 py-12 md:py-16 lg:grid-cols-[1.35fr_.65fr] lg:items-center">
    <div>
      {/* Titre = la phrase-mission de la fiche projet, en gros et en gras (retour du 26/10/2026). */}
      <h1 class="home-hero-title">{hero.lead}</h1>
      <svg class="hero-underline mt-5" width="220" height="14" viewBox="0 0 220 14" fill="none" aria-hidden="true" focusable="false">
        <path pathLength="100" d="M4 8c20-6 40 6 60 0s40-6 60 0 40 6 60 0 30-6 32 0" stroke="url(#heroLineGrad)" stroke-width="4" stroke-linecap="round" />
        <defs>
          <linearGradient id="heroLineGrad" x1="0" x2="1">
            <stop style="stop-color:#00B6FF" />
            <stop offset=".5" style="stop-color:#C084FC" />
            <stop offset="1" style="stop-color:#FF8A3D" />
          </linearGradient>
        </defs>
      </svg>
      <div class="mt-10">
        <Button href={hero.cta.href} variant="orange" class="!min-h-[60px] !px-8 !py-4 !text-[1.45rem]">{hero.cta.label}</Button>
      </div>
    </div>
    <div class="relative">
      {/* Dessin d'Inès Ramdani (papillon et livre) : décoratif, ignoré des lecteurs d'écran. */}
      <img src="/images/papillion.png" width="575" height="504" alt="" class="home-hero-art" loading="eager" decoding="async" />
      <div class="home-hero-card">
        <p class="m-0 text-xl leading-relaxed md:text-[1.35rem]">{hero.intentionText}</p>
      </div>
    </div>
  </div>

  {/* Invitation à défiler : lien vers la section suivante, flèche animée (rebond doux),
      immobile si mouvement réduit (préférence système ou bouton « Réduire les animations »). */}
  <a href={hero.scrollCue.href} class="scroll-cue">
    <span>{hero.scrollCue.label}</span>
    <svg class="scroll-cue-arrow" aria-hidden="true" focusable="false" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
  </a>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Première partie en pleine page : tout l'écran sous le bandeau (hauteur réelle du
       bandeau mesurée par ScrollFX). */
    min-height: calc(100svh - var(--header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
  }
  .home-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .home-hero-veil {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(115deg, rgba(16, 42, 78, 0.9) 0%, rgba(30, 80, 140, 0.78) 50%, rgba(76, 29, 149, 0.72) 100%);
  }
  .home-hero > .wrap { width: 100%; margin-block: auto; }
  .home-hero-title {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1.12;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }
  .home-hero-art { display: block; width: min(100%, 20rem); height: auto; margin: 0 auto -2.5rem; }
  .home-hero-card {
    position: relative;
    padding: 1.6rem 1.75rem;
    background: #fff;
    color: var(--color-ink);
    border-radius: var(--radius-md, 8px);
    border-top: 6px solid transparent;
    border-image: linear-gradient(90deg, #00B6FF, #7C3AED, #FF005D, #FF8A3D, #8DC63F) 1;
    box-shadow: 0 18px 36px -16px rgba(0, 0, 0, 0.55);
  }
  @media (max-width: 63.99rem) { .home-hero-art { width: 13rem; } }

  .scroll-cue {
    align-self: center;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    margin: 0 0 1.25rem;
    padding: 0.4rem 0.9rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
  }
  .scroll-cue:hover span { text-decoration: underline; }
  .scroll-cue-arrow { color: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue-arrow { animation: scroll-cue-bounce 1.6s ease-in-out infinite; }
  }
  @keyframes scroll-cue-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  :global(body.high-contrast) .home-hero-veil { background: #000; }
</style>
