---
// Source : fiche projet officielle de l'association (PDF, page 2).
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { pourquoiSoutenir as content } from '../../data/content';
import { accent } from '../../lib/accents';
---
<Section id="pourquoi-soutenir" tone="tint" eyebrow={content.eyebrow} title={content.title}>
  <ul class="home-reasons reveal-grid">
    {content.reasons.map((reason, i) => (
      <li>
        <span class="home-check" style={`background:${accent(i).text}`} aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </span>
        <span class="font-semibold">{reason}</span>
      </li>
    ))}
  </ul>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    <div class="home-support bg-blue-deep">
      <p class="home-support-title">{content.mecenat.title}</p>
      <p class="m-0">{content.mecenat.text}</p>
    </div>
    <div class="home-support" style="background:#6D28D9">
      <p class="home-support-title">{content.benevolat.title}</p>
      <p class="m-0">{content.benevolat.text}</p>
    </div>
  </div>
  <Button href={content.more.href} variant="cta" class="mt-10">{content.more.label}</Button>
</Section>

<style>
  .home-reasons { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .home-reasons { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .home-reasons > li {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 1rem 1.15rem; background: #fff;
    border: 1px solid var(--color-blue-soft); border-radius: var(--radius-md, 8px);
    line-height: 1.55;
  }
  .home-check {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 1.75rem; height: 1.75rem; border-radius: 999px; margin-top: 0.05rem;
  }
  /* Texte blanc sur bleu profond (4.9:1) et violet #6D28D9 (7.1:1) : AA. */
  .home-support { padding: 1.75rem; border-radius: var(--radius-md, 8px); color: #fff; line-height: 1.6; }
  .home-support-title { margin: 0 0 0.6rem; font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; }
</style>
