---
import Section from '../layout/Section.astro';
import { besoin as content } from '../../data/content';
import { accent } from '../../lib/accents';
---
<Section id="besoin" tone="tint" eyebrow={content.eyebrow} title={content.title}>
  <div class="measure">
    {content.paragraphs.map((paragraph) => <p class="m-0 text-xl leading-[1.6]">{paragraph}</p>)}
  </div>
  <ol class="std-card-list reveal-grid mt-8">
    {content.bullets.map((bullet, i) => (
      <li style={`--accent:${accent(i).bar}`}>
        <span class="std-card-num" style={`color:${accent(i).text}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <p class="m-0 text-lg font-semibold">{bullet}</p>
      </li>
    ))}
  </ol>
</Section>
