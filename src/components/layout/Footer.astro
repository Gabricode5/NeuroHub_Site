---
import { site } from '../../data/site';
import { footer } from '../../data/content';
---
<footer class="bg-blue-deep py-10 text-white">
  <div class="wrap grid gap-8 md:grid-cols-2">
    <div>
      <p class="m-0 font-bold">{site.title}</p>
      <p class="mb-0 mt-2 text-sm">
        {site.legalLine}<br />
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
    </div>
    <div class="text-sm md:text-right">
      <p class="m-0">{footer.accessibilityNote}</p>
    </div>
  </div>
</footer>
