---
// Formulaire « Échangeons » (page Contact) : pas de serveur, il ouvre la messagerie du
// visiteur avec un e-mail pré-rempli vers l'association (mailto). Sans JavaScript, le
// navigateur envoie le formulaire au même mailto en texte brut.
import { site } from '../../data/site';
import { contact as content } from '../../data/content';
---
<form
  class="contact-form"
  action={`mailto:${site.contactEmail}`}
  method="post"
  enctype="text/plain"
  data-mailto={site.contactEmail}
  data-subject={content.subject}
>
  <p class="contact-intro">{content.intro}</p>
  <div class="contact-row">
    <label for="contact-nom">Nom
      <input id="contact-nom" name="Nom" autocomplete="family-name" required />
    </label>
    <label for="contact-prenom">Prénom
      <input id="contact-prenom" name="Prénom" autocomplete="given-name" required />
    </label>
  </div>
  <div class="contact-row">
    <label for="contact-email">E-mail
      <input id="contact-email" name="E-mail" type="email" autocomplete="email" required />
    </label>
    <label for="contact-tel">Téléphone <span class="contact-optional">(facultatif)</span>
      <input id="contact-tel" name="Téléphone" type="tel" autocomplete="tel" />
    </label>
  </div>
  <label for="contact-message">Message
    <textarea id="contact-message" name="Message" rows="6" required></textarea>
  </label>
  <button class="button button-orange" type="submit">{content.submitLabel}</button>
  <p class="contact-note">{content.note} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-blue-soft);
    border-top: 6px solid transparent;
    border-image: linear-gradient(90deg, #00B6FF, #7C3AED, #FF005D, #FF8A3D, #8DC63F) 1;
    box-shadow: 0 18px 40px -20px rgba(39, 115, 178, 0.5);
  }
  .contact-intro { margin: 0; }
  .contact-row { display: grid; gap: 1.25rem; }
  @media (min-width: 40rem) { .contact-row { grid-template-columns: 1fr 1fr; } }
  label { display: block; font-weight: 700; }
  .contact-optional { font-weight: 400; }
  input, textarea {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.7rem 0.8rem;
    font: inherit;
    font-weight: 400;
    color: var(--color-ink);
    background: #fff;
    border: 2px solid var(--color-blue-deep);
    border-radius: var(--radius-sm, 4px);
  }
  textarea { resize: vertical; }
  button { justify-self: start; }
  .contact-note { margin: 0; font-size: 0.95rem; }
</style>

<script>
  // Construit un e-mail lisible (une ligne par champ) et ouvre la messagerie du visiteur.
  document.querySelectorAll<HTMLFormElement>('form[data-mailto]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (!form.checkValidity()) return;
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const lines = [
        `Nom : ${get('Nom')}`,
        `Prénom : ${get('Prénom')}`,
        `E-mail : ${get('E-mail')}`,
        get('Téléphone') ? `Téléphone : ${get('Téléphone')}` : '',
        '',
        get('Message')
      ].filter((l, i) => l !== '' || i === 4);
      const subject = `${form.dataset.subject} – ${get('Prénom')} ${get('Nom')}`;
      window.location.href =
        `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  });
</script>
