---
// Grille des membres / conseil d'administration. Photos à ajouter : voir README.
import Button from '../ui/Button.astro';
import { porteurs as content } from '../../data/content';
import { site } from '../../data/site';

// Accents individuels demandés par la présidente (retours du 17/09/2026) : violet pour
// Frédéric Bonniot, rose pour Inès Ramdani. Les autres membres gardent le bandeau bleu
// neutre existant (non précisé par la présidente, donc laissé inchangé). Nuances choisies
// pour rester largement au-dessus du seuil AA (≥4.5:1) avec les initiales blanches, aux
// deux extrémités du dégradé — vérifié : 5.7:1 et 10.95:1 (violet), 4.7:1 et 9.57:1 (rose).
const accentByName: Record<string, string> = {
  'Frédéric Bonniot': 'from-[#7C3AED] to-[#4C1D95]',
  'Inès Ramdani': 'from-[#E11D48] to-[#881337]'
};
---
{[
  { title: 'Conseil d’administration', members: content.board },
  { title: 'Membres bienfaiteurs', intro: content.benefactorsIntro, members: content.benefactors }
].map((group) => (
  <div class="mt-10">
    <h3 class="m-0 text-2xl font-bold">{group.title}</h3>
    {group.intro && <p class="measure leading-[1.7]">{group.intro}</p>}
    <ul class="team-grid reveal-grid">
      {group.members.map((member) => (
        <li class="team-member">
          {member.photo ? (
            <img src={member.photo} alt="" width="288" height="288" class="team-avatar team-photo" loading="lazy" decoding="async" />
          ) : (
            <div
              class:list={['team-avatar bg-gradient-to-br', accentByName[member.name] ?? 'from-blue to-blue-deep']}
              role="img"
              aria-label={`Emplacement photo de ${member.name}, à remplacer`}
            >
              {member.initials}
            </div>
          )}
          <h4 class="m-0 mt-4 text-xl font-bold">{member.name}</h4>
          <p class="mb-0 mt-1 font-semibold text-blue-deep">{member.role}</p>
        </li>
      ))}
    </ul>
  </div>
))}
<p class="source mt-5">{content.note}</p>

{/* Adhésion (retour du 26/10/2026) : lien HelloAsso à renseigner dans site.ts (adhesionUrl) ;
    en attendant, le bouton mène au formulaire de contact. */}
<div class="mt-10">
  <Button href={site.adhesionUrl || '/soutenir#contact'} variant="orange" class="!min-h-[56px] !px-7 !py-3.5 !text-[1.3rem]">Adhésion à l’association</Button>
</div>

<style>
  /* Portraits en cercle (initiales en attendant les photos), nom et rôle centrés dessous. */
  .team-grid { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); }
  .team-member { text-align: center; }
  .team-avatar {
    display: flex; align-items: center; justify-content: center;
    width: 9rem; height: 9rem; margin: 0 auto; border-radius: 999px;
    color: #fff; font-size: 2.4rem; font-weight: 700;
    box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--color-blue-soft);
  }
  .team-photo { display: block; object-fit: cover; }
</style>
